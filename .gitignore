# macOS Finder droppings. They change constantly and would make the watcher
# commit noise all day, which is exactly how a busy channel starts looking like
# a broken one.
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editor and temporary files, so a half-saved document never travels as though
# it were a delivered instruction.
*.swp
*~
.~lock.*
